#!/bin/sh
# pre-push — runs CheckCodeGuardrails before any push leaves the developer machine.
#
# BLOCKS the push on the three reliable code bans (SerializeField / Resources.Load /
# Instantiate). BuilderDrift runs ADVISORY (logged, non-blocking) — it currently emits
# resolution-dependent false positives under headless batchmode; re-promote it to blocking
# (point this at CheckAllGuardrails) once the drift signature is fixed and Game/TitleScreen
# drift is audited. One Unity batchmode launch covers all checks (~30–60s cold, ~10–20s warm).
#
# Activation:  git config core.hooksPath .githooks
#              (or run GridGame.Console.ps1 -> Option 4 "Setup")
# Bypass:      git push --no-verify   (use only for urgent hotfixes)

set -e

PROJ="$(git rev-parse --show-toplevel)"

# Derive the editor version from ProjectVersion.txt (authoritative) instead of hardcoding it.
# A hardcoded version silently breaks on every editor upgrade: the candidate paths stop
# matching, UNITY stays empty, and the hook skips ALL guardrail enforcement without anyone
# noticing (this happened — it was pinned to 6000.3.2f1 while the project moved to 6000.4.3f1).
VER="$(sed -n 's/^m_EditorVersion: //p' "$PROJ/ProjectSettings/ProjectVersion.txt" | tr -d '\r')"
if [ -z "$VER" ]; then
    echo "[pre-push] Could not read editor version from ProjectVersion.txt; skipping guardrail check."
    exit 0
fi

# Locate the Unity editor for that exact version across common install paths.
UNITY=""
for candidate in \
    "/c/Program Files/Unity/Hub/Editor/$VER/Editor/Unity.exe" \
    "/Applications/Unity/Hub/Editor/$VER/Unity.app/Contents/MacOS/Unity" \
    "$HOME/Unity/Hub/Editor/$VER/Editor/Unity"
do
    if [ -x "$candidate" ]; then UNITY="$candidate"; break; fi
done

if [ -z "$UNITY" ]; then
    # Unity missing locally (CI runner, fresh clone, etc.) — don't block,
    # since guardrails re-run server-side if CI is wired up.
    echo "[pre-push] Unity $VER not found on PATH; skipping guardrail check."
    exit 0
fi

# Batchmode can't acquire the project lock if the Editor is open. Detect that up front and
# print a useful message rather than letting Unity exit with a cryptic license-or-lock error.
# Unity 6 writes Temp/UnityLockfile while a session holds the project; if that file exists
# AND can't be opened for writing, an Editor is alive on this project.
LOCKFILE="$PROJ/Temp/UnityLockfile"
if [ -f "$LOCKFILE" ]; then
    # Try to obtain an exclusive lock on the file. If we can't, the Editor still holds it.
    # Portable check: attempt to rename in-place (atomic, no data change); succeeds only if
    # the OS isn't keeping a writer handle.
    if ! ( exec 9<>"$LOCKFILE" ) 2>/dev/null; then
        echo "[pre-push] Unity Editor appears to be running on this project (Temp/UnityLockfile held)."
        echo "[pre-push] Batchmode can't acquire the project lock while the Editor is open."
        echo "[pre-push] Close the Editor and retry the push, or bypass with: git push --no-verify"
        exit 1
    fi
fi

mkdir -p "$PROJ/Logs"
LOG="$PROJ/Logs/pre-push-$(date +%Y%m%d-%H%M%S).log"

# Gate on the three reliable CODE guardrails (SerializedField / Resources.Load / Instantiate).
# BuilderDrift runs ADVISORY inside CheckCodeGuardrails (logged, non-blocking) because it emits
# resolution-dependent false positives in headless batchmode — see CliEntryPoints.CheckCodeGuardrails.
echo "[pre-push] Running CheckCodeGuardrails (log: $LOG)"
"$UNITY" -batchmode -nographics \
    -projectPath "$PROJ" \
    -executeMethod CliEntryPoints.CheckCodeGuardrails \
    -quit -logFile "$LOG"
RC=$?

if [ "$RC" -ne 0 ]; then
    echo ""
    echo "[pre-push] FAIL — CheckAllGuardrails exit $RC"
    echo "[pre-push] Tail of log:"
    tail -40 "$LOG" | sed 's/^/    /'
    echo ""
    echo "[pre-push] Fix the failing guardrail, or bypass with: git push --no-verify"
    exit 1
fi

echo "[pre-push] OK — all guardrails clean."
exit 0
