#!/bin/sh
# pre-push — runs CheckAllGuardrails before any push leaves the developer machine.
#
# Enforces the ban guardrails (SerializeField / Resources.Load / Instantiate)
# and scaffold drift check introduced in Phases 1–6. One Unity batchmode launch
# covers all four (~30–60s cold, ~10–20s warm).
#
# Activation:  git config core.hooksPath .githooks
#              (or run GridGame.Console.ps1 -> Option 4 "Setup")
# Bypass:      git push --no-verify   (use only for urgent hotfixes)

set -e

PROJ="$(git rev-parse --show-toplevel)"

# Locate Unity 6000.3.2f1 across common install paths.
UNITY=""
for candidate in \
    "/c/Program Files/Unity/Hub/Editor/6000.3.2f1/Editor/Unity.exe" \
    "/Applications/Unity/Hub/Editor/6000.3.2f1/Unity.app/Contents/MacOS/Unity" \
    "$HOME/Unity/Hub/Editor/6000.3.2f1/Editor/Unity"
do
    if [ -x "$candidate" ]; then UNITY="$candidate"; break; fi
done

if [ -z "$UNITY" ]; then
    # Unity missing locally (CI runner, fresh clone, etc.) — don't block,
    # since guardrails re-run server-side if CI is wired up.
    echo "[pre-push] Unity 6000.3.2f1 not found on PATH; skipping guardrail check."
    exit 0
fi

mkdir -p "$PROJ/Logs"
LOG="$PROJ/Logs/pre-push-$(date +%Y%m%d-%H%M%S).log"

echo "[pre-push] Running CheckAllGuardrails (log: $LOG)"
"$UNITY" -batchmode -nographics \
    -projectPath "$PROJ" \
    -executeMethod CliEntryPoints.CheckAllGuardrails \
    -quit -logFile "$LOG"
RC=$?

if [ "$RC" -ne 0 ]; then
    echo ""
    echo "[pre-push] FAIL — CheckAllGuardrails exit $RC"
    echo "[pre-push] Tail of log:"
    tail -40 "$LOG" | sed 's/^/    /'
    echo ""
    echo "[pre-push] Fix the failing guardrail, or bypass with: git push --no-verify"
    exit 1
fi

echo "[pre-push] OK — all guardrails clean."
exit 0
