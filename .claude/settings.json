{
    "statusLine":  {
                       "type":  "command",
                       "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/statusline.ps1\""
                   },
    "$schema":  "https://json.schemastore.org/claude-code-settings.json",
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "powershell",
                                                             "args":  [
                                                                          "-NoProfile",
                                                                          "-ExecutionPolicy",
                                                                          "Bypass",
                                                                          "-File",
                                                                          ".claude/hooks/inject-digest.ps1"
                                                                      ],
                                                             "timeout":  10,
                                                             "statusMessage":  "Loading docs/BIBLE.digest.md..."
                                                         }
                                                     ]
                                       }
                                   ],
                  "UserPromptSubmit":  [
                                           {
                                               "hooks":  [
                                                             {
                                                                 "type":  "command",
                                                                 "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/quickload-on-do.ps1\""
                                                             }
                                                         ]
                                           }
                                       ]
              }
}
