{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/inject-digest.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Loading docs/BIBLE.digest.md..."
          }
        ]
      }
    ]
  }
}
